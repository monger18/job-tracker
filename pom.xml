<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The parent supplies tested, compatible versions for hundreds of libraries,
         so below we can declare a dependency WITHOUT a <version>. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- This project's own identity (like a package name for the built jar). -->
    <groupId>com.satyam</groupId>
    <artifactId>job-tracker</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>job-tracker</name>

    <properties>
        <!-- The parent reads this and compiles for Java 17. -->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Embedded Tomcat + Spring MVC + JSON support: everything needed for a REST API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Adds `mvn spring-boot:run` and packages a runnable fat jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
